# 开发环境配置
# 说明：文件名规则 .env.[mode]，通过 vue-cli-service serve --mode development 加载
# 自定义环境变量必须以 VUE_APP_ 为前缀，否则不会注入到 process.env（防止意外泄露机器敏感变量）

NODE_ENV=development

# 系统标题
VUE_APP_TITLE='电子档案管理系统'

# 后端接口基础路径：配合 vue.config.js 中 devServer.proxy 转发到真实后端，解决开发期跨域
VUE_APP_BASE_API='/dev-api'

# 静态 DEMO 开关：true 时登录/获取用户信息/退出均不走后端接口（本地模拟数据）
# 后端联调时改为 false 或删除此行即可恢复真实接口
VUE_APP_USE_MOCK=true
