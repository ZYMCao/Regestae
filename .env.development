# 开发环境配置
# 说明：文件名规则 .env.[mode]，通过 vite --mode development 加载
# 自定义环境变量必须以 VITE_ 为前缀，否则不会注入到 import.meta.env（防止意外泄露机器敏感变量）
# （NODE_ENV 由 Vite 按命令自动决定：dev 为 development，build 为 production，无需声明）

# 系统标题
VITE_TITLE='电子档案管理系统'

# 后端接口基础路径：配合 vite.config.js 中 server.proxy 转发到真实后端，解决开发期跨域
VITE_BASE_API='/dev-api'

# 静态 DEMO 开关：true 时登录/获取用户信息/退出均不走后端接口（本地模拟数据）
# 后端联调时改为 false 或删除此行即可恢复真实接口
VITE_USE_MOCK=true
